node_modules/
.env
.env.*
!.env.example

# Python: the DKT service shares this folder but not its runtime.
__pycache__/
*.py[cod]
.venv/
venv/

# Trained weights. The checkpoint behind the reported result is committed, at
# under half a megabyte; ad-hoc checkpoints from other runs are not.
checkpoints/*.pt
!checkpoints/dkt_lstm_paper.pt

# Interaction logs are personal data about minors and never belong in git. The
# synthetic corpus is excluded too: it is 46 MB and one seeded command
# regenerates it byte for byte.
data/*.csv

# Evaluation artefacts: they contain course text and generated answers, and are
# regenerated by the scripts in src/scripts.
eval/*.jsonl
!eval/test_dataset.example.jsonl
results/

*.log
npm-debug.log*
.ipynb_checkpoints/
.DS_Store
Thumbs.db
.idea/
.vscode/
