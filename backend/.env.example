# Copy to .env and fill in. Never commit the filled file.

# ── Service ────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# Number of reverse-proxy hops in front of this service. 0 when exposed
# directly; 1 behind a single nginx/CDN layer. Rate limiting reads the client
# address through this, so a wrong value either throttles the proxy itself or
# lets a caller spoof its address.
TRUST_PROXY_HOPS=0
RATE_LIMIT_MAX=200

# ── MySQL ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Optional: connect over a unix socket instead of TCP. Detected automatically
# at the usual paths when left unset.
# DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_POOL_SIZE=10

# ── Authentication ─────────────────────────────────────────────────────────
# Must match the secret used by whichever service issues the tokens.
JWT_SECRET=
# Development only: accept unauthenticated requests. Leave unset in production.
# AUTH_DISABLED=0

# ── Vector store (Qdrant) ──────────────────────────────────────────────────
# Semantic retrieval turns on only when QDRANT_URL and COHERE_API_KEY are both
# set. Without them the service still answers, using keyword retrieval.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
RAG_QDRANT_COLLECTION=bac_rag_chunks
# Force one auth header when a managed cluster rejects the other. JWT-style
# keys (starting `eyJ`) default to Bearer; classic keys use the api-key header.
# QDRANT_USE_BEARER_AUTH=1
# QDRANT_USE_API_KEY_HEADER=1
# Set to 0 to disable semantic search even when the variables above are present.
# RAG_USE_QDRANT=1
# Upsert without blocking the request that triggered it. Useful during a large
# import; leave off when a script must observe the index it just wrote.
# RAG_QDRANT_ASYNC=0

# ── Embeddings (Cohere) ────────────────────────────────────────────────────
COHERE_API_KEY=
RAG_EMBEDDING_MODEL=embed-multilingual-v3.0
# Must match the model: 1024 for embed-multilingual-v3.0, one of
# 256/512/1024/1536 for embed-v4. A mismatch is rejected at index time rather
# than producing a silently unusable collection.
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBED_BATCH_SIZE=32

# ── Retrieval tuning ───────────────────────────────────────────────────────
RAG_DEFAULT_SUBJECT=التاريخ والجغرافيا
RAG_TOP_K=5
RAG_TOP_K_LOCAL=3
# Candidates fetched per requested chunk before de-duplication by section.
RAG_QDRANT_OVERFETCH=4
# Drop Qdrant hits below this cosine score outright. Unset by default.
# RAG_QDRANT_SCORE_THRESHOLD=0.35
# Top-hit cosine score below which retrieval counts as weak, which routes the
# question to the knowledge-fallback prompt instead of the grounded one.
RAG_SEMANTIC_WEAK_TOP_SCORE=0.42
# Rebuild rag_chunks from course_parts at startup. Set to 0 on replicas and
# during evaluation runs that must index a frozen corpus.
RAG_AUTO_SYNC=1

# ── Mastery-conditioned difficulty ─────────────────────────────────────────
# Boundaries of the three difficulty tiers, applied to the optional `mastery`
# field on POST /api/rag/ask. Below the first: scaffolded answers. Above the
# second: stretch answers. Between them: examination difficulty.
#
# These are pedagogical boundaries, not fitted ones — "cannot yet do this
# alone" and "is no longer being stretched". Move them only on cohort evidence,
# which is also why they are configurable rather than hard-coded.
RAG_MASTERY_FOUNDATIONAL_MAX=0.50
RAG_MASTERY_CHALLENGE_MIN=0.80

# ── Generator ──────────────────────────────────────────────────────────────
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_CHAT_MODEL=deepseek-chat
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_MS=120000
# Offline only: the model used as judge by the evaluation harness.
LLM_JUDGE_MODEL=deepseek-v4-pro

# ── Self-hosted generator, for /api/rag/ask-local ──────────────────────────
LOCAL_OPENAI_BASE_URL=http://localhost:8000/v1
LOCAL_OPENAI_MODEL=local-model
LOCAL_OPENAI_API_KEY=local-api-key
LOCAL_OPENAI_TIMEOUT_MS=120000
LOCAL_MAX_TOKENS=350

# ═══════════════════════════════════════════════════════════════════════════
# DKT service (Python, `uvicorn dkt.api:app`)
# ═══════════════════════════════════════════════════════════════════════════
# The knowledge tracer reads the same MySQL and verifies the same JWT_SECRET as
# the RAG service above, which is why neither is repeated here.

# ── Data ───────────────────────────────────────────────────────────────────
# Training corpus. Export real interactions with:
#   python -m dkt.scripts.export_interactions --out data/interactions.csv
DKT_CSV=data/dkt_interactions.csv

# Maximum awarded score. The platform's AI grader emits 0-100 even though an old
# schema comment says 0-10. Wrong here and the model trains on targets squashed
# into a tenth of their range: it looks converged and predicts nothing.
DKT_SCORE_SCALE=100

# Fractions of LEARNERS held out — never fractions of rows. Splitting by row
# puts a learner's future in training and their past in validation, which is the
# standard way to report an unreproducible result. Train gets the first
# fraction, validation the second, and the remainder is a test split that is
# touched once, when a result is reported.
DKT_TRAIN_USER_FRAC=0.8
DKT_VAL_USER_FRAC=0.1

# Learners with fewer interactions than this are dropped: a sequence of length 1
# produces no next-step target.
DKT_MIN_SEQ_LEN=2

# Long histories are split into consecutive windows of this length rather than
# truncated, so the most recent interactions are never discarded.
DKT_MAX_SEQ_LEN=200

DKT_SEED=42

# ── Model ──────────────────────────────────────────────────────────────────
DKT_EMBED_DIM=64
DKT_HIDDEN_DIM=128
DKT_LAYERS=1
# PyTorch ignores dropout on a single LSTM layer; raise DKT_LAYERS to use it.
DKT_DROPOUT=0.0

# ── Training ───────────────────────────────────────────────────────────────
DKT_EPOCHS=20
DKT_BATCH_SIZE=32
DKT_LR=0.001
# LSTMs on long sequences produce occasional very large gradients; clipping
# stops one pathological batch from destroying a converged model.
DKT_GRAD_CLIP=5.0
# Epochs without validation improvement before stopping. These models overfit
# small cohorts within a handful of epochs.
DKT_PATIENCE=5
DKT_CHECKPOINT=checkpoints/dkt_lstm_paper.pt

# ── Service ────────────────────────────────────────────────────────────────
DKT_API_HOST=0.0.0.0
DKT_API_PORT=5002
